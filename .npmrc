# Survive the npm registry rate-limiting our builds.
#
# Render has failed four times with the same error, always on the same package:
#
#   npm error code E429
#   npm error 429 Too Many Requests - GET https://registry.npmjs.org/@medusajs%2fjs-sdk
#
# A 429 is not a broken dependency, it is the registry declining to answer
# right now. npm's defaults give a request two retries over at most a minute,
# which is nowhere near enough when a shared cloud IP is being throttled, and
# it fires fifteen requests at once by default, which is what provokes the
# throttling in the first place.
#
# npm reads .npmrc from the working directory and every directory above it, so
# this applies to the root install, the workspace installs and the nested
# install medusa build runs inside .medusa/server. That last one is why the
# setting lives here rather than in a build command: it is the install we do
# not control and cannot pass flags to.

# Ask fewer things at once. Slower, and far less likely to be told to go away.
maxsockets=3

# Then wait properly when told to. Six attempts backing off toward three
# minutes, instead of two attempts inside one.
fetch-retries=6
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=180000
fetch-timeout=600000

# Use anything already cached rather than re-asking. Every dependency in this
# repo is pinned to an exact version, so there is no newer thing to miss.
prefer-offline=true
